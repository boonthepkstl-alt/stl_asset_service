# Copy this file to `.env` in the repo root to override docker-compose.yml's defaults.
# `docker compose` reads a `.env` file in the same directory as docker-compose.yml
# automatically -- no --env-file flag needed.

# --- Database ---
DB_PG_USER=raise
DB_PG_PASS=raise_dev_password
DB_PG_INST=raise
DB_PG_PORT=5432

# --- Backend ---
BACKEND_PORT=8080
# Origins the backend's CORS middleware allows -- docker-compose.yml derives this from
# FRONTEND_PORT below by default (http://localhost:<FRONTEND_PORT>), so leave it unset
# unless the frontend is reachable at a different origin than that (e.g. a
# comma-separated multi-origin list). Uncomment only to override the derived default:
# CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Frontend ---
FRONTEND_PORT=3000
# Baked into the frontend bundle at build time (see frontend/Dockerfile) -- must be
# reachable from the browser, not just from inside the Docker network.
# docker-compose.yml derives this from BACKEND_PORT above by default
# (http://localhost:<BACKEND_PORT>/api), so leave it unset unless you need something
# else (e.g. a non-localhost host). Uncomment only to override the derived default:
# VITE_API_BASE_URL=http://localhost:8080/api

# All default true for this stack -- set any to "false" to fall back to that domain's
# in-memory Mock*Repository fixtures instead of the real backend container (e.g. useful
# if you want to demo the frontend alone without a working Postgres schema for one
# domain). Also baked in at build time -- changing these requires a rebuild
# (`docker compose build frontend`), not just a restart.
VITE_AUTH_API_ENABLED=true
VITE_ASSET_API_ENABLED=true
VITE_EMPLOYEE_API_ENABLED=true
VITE_TICKET_API_ENABLED=true
VITE_AUDIT_API_ENABLED=true
VITE_DASHBOARD_API_ENABLED=true
