# Base URL the frontend calls for the Go backend API (see API-SPECIFICATION.md).
# The frontend must never call Gemini directly and must never hold GEMINI_API_KEY/DB credentials.
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_ENV=development

# Set to "true" to reveal Roadmap-only pages/nav entries that are built but not yet MVP-confirmed
# (Software License -- RAISE-FR-LICENSE-001, AI Decision Center -- RAISE-AI-RECOMMEND-001).
# Leave unset/false for a build that reflects only confirmed MVP scope. See
# frontend/src/config/featureFlags.ts.
VITE_ENABLE_ROADMAP_FEATURES=false
