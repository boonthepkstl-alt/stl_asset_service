# Base URL the frontend calls for the Go backend API (see API-SPECIFICATION.md).
# The frontend must never call Gemini directly and must never hold GEMINI_API_KEY/DB credentials.
# Unversioned /api, matching what go-template-main's router actually serves today
# (router/sampleRouter.go) -- API versioning to /api/v1 is a separate, still-open decision.
VITE_API_BASE_URL=http://localhost:8080/api
VITE_APP_ENV=development

# Set to "true" to reveal Roadmap-only pages/nav entries that are built but not yet MVP-confirmed
# (Software License -- RAISE-FR-LICENSE-001, AI Decision Center -- RAISE-AI-RECOMMEND-001).
# Leave unset/false for a build that reflects only confirmed MVP scope. See
# frontend/src/config/featureFlags.ts.
VITE_ENABLE_ROADMAP_FEATURES=false

# Set to "true" only when a real go-template-main instance (with sql/pg/V1__Assets_Table.sql
# applied) is running at VITE_API_BASE_URL. Leave unset/false to keep using
# MockAssetRepository's in-memory fixtures (the default -- no backend required for local dev
# or the test suite). See frontend/src/config/featureFlags.ts.
VITE_ASSET_API_ENABLED=false

# Same as VITE_ASSET_API_ENABLED, for the Employee domain (with
# sql/pg/V2__Employees_Table.sql applied). Independent flag since the two backends can land/be
# enabled separately.
VITE_EMPLOYEE_API_ENABLED=false
