# Copy this file to `.env` in the repo root to override docker-compose.yml's defaults.
# `docker compose` reads a `.env` file in the same directory as docker-compose.yml
# automatically -- no --env-file flag needed.

# --- Database ---
DB_PG_USER=raise
DB_PG_PASS=raise_dev_password
DB_PG_INST=raise
DB_PG_PORT=5432

# --- Backend ---
BACKEND_PORT=8080
# Origins the backend's CORS middleware allows -- must match wherever the frontend is
# actually reachable from a browser (FRONTEND_PORT below, on localhost for local dev).
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Frontend ---
FRONTEND_PORT=3000
# Baked into the frontend bundle at build time (see frontend/Dockerfile) -- must be
# reachable from the browser, not just from inside the Docker network. If you change
# BACKEND_PORT above, update this to match.
VITE_API_BASE_URL=http://localhost:8080/api
